datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Difficulty {
  EASY
  MODERATE
  STRENUOUS
  CHALLENGING
}

enum Region {
  EVEREST
  ANNAPURNA
  LANGTANG
  MANASLU
  MUSTANG
  POKHARA
  CHITWAN
  KATHMANDU
}

enum TourCategory {
  TREKKING
  EXPEDITION
  CULTURAL_HERITAGE
  WILDLIFE_SAFARI
  DAY_HIKE
  LAKES_AND_SOFT_ADVENTURE
  PILGRIMAGE_AND_HERITAGE
  CUSTOM_PRIVATE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum InquiryType {
  GENERAL
  CUSTOM_TOUR
  TRIP_SPECIFIC
  CORPORATE_OR_PRIVATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(CUSTOMER)
  phone              String?
  country            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Password reset token fields (store hashed token only)
  resetPasswordTokenHash String?   @unique
  resetPasswordExpiresAt DateTime?

  bookings           Booking[]
  inquiries          Inquiry[]

  @@index([email])
  @@index([role])
}

model Destination {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  region              Region
  elevation           String?
  tagline             String
  description         String   @db.Text
  heroImage           String
  highlights          String[]
  bestTime            String?
  recommendedDuration String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trips               Trip[]

  @@index([region])
}

model Trip {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  subtitle         String
  durationDays     Int
  maxAltitudeMeters Int         // Max altitude in meters
  difficulty       Difficulty
  category         TourCategory
  region           Region
  startingPoint    String
  endingPoint      String
  bestSeasons      String[]     // e.g. ["Spring (Mar-May)", "Autumn (Sep-Nov)"]
  featured         Boolean      @default(false)
  priceFromUsd     Int
  currency         String       @default("USD")
  maxGroupSize     Int          @default(10)
  fitnessRequired  String?      @db.Text
  heroImage        String
  overview         String       @db.Text
  highlights       String[]
  itinerarySummary String[]     // e.g. ["Day 1: Fly Lukla...", "Day 2: Namche..."]
  includedItems    String[]
  excludedItems    String[]
  isPublished      Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  destinationId    String?
  destination      Destination? @relation(fields: [destinationId], references: [id])
  inquiries        Inquiry[]
  bookings         Booking[]

  @@index([category])
  @@index([difficulty])
  @@index([region])
  @@index([isPublished])
}

model Booking {
  id                   String             @id @default(cuid())
  reference            String             @unique // e.g. HT-2026-X8Y9Z
  tripId               String
  trip                 Trip               @relation(fields: [tripId], references: [id])
  departureDate        DateTime
  travelerCount        Int
  totalPriceSnapshotUsd Int
  currencySnapshot     String             @default("USD")
  status               BookingStatus      @default(PENDING)
  
  // Associated authenticated User (optional for guest bookings)
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])

  // Guest / Traveler contact details
  fullName             String
  email                String
  phone                String
  nationality          String
  specialRequirements  String?            @db.Text
  privacyAgreed        Boolean            @default(true)
  idempotencyKey       String?            @unique

  // Cancellation / Change requests
  changeRequestNotes   String?            @db.Text

  // Notification delivery status
  businessNotifyStatus NotificationStatus @default(PENDING)
  customerNotifyStatus NotificationStatus @default(PENDING)
  notificationLog      String?            @db.Text

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([departureDate])
}

model Inquiry {
  id             String        @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  country        String?
  type           InquiryType   @default(GENERAL)
  subject        String
  customMessage  String        @db.Text
  travelMonth    String?
  groupSize      Int?          @default(1)
  status         InquiryStatus @default(NEW)
  adminNotes     String?       @db.Text

  // Optional User linkage
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])

  // Optional related Trip
  tripId         String?
  trip           Trip?         @relation(fields: [tripId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([type])
}

model TravelArticle {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  content        String   @db.Text
  readingTimeMin Int
  category       String
  coverImage     String
  publishedAt    DateTime @default(now())
}
